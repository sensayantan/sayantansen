{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "sayantansen-autism-search",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",

  // Workers AI: embeds the visitor's question and writes the summary.
  // Bound rather than called over HTTP, so no API token lives anywhere.
  "ai": {
    "binding": "AI"
  },

  "vars": {
    // The model that writes the summary. Cloudflare retires these on a
    // schedule, so it lives here rather than in code: check the current
    // Workers AI catalogue, paste the id, redeploy. GET /api/health reports
    // the value this deployment is actually using.
    //
    // Two constraints, both learned the hard way. The name must not be
    // deprecated: the first value resolved to
    // @cf/meta/infire-llama-3.1-8b-instruct and failed with "5028: ...
    // was deprecated on 2026-05-30". And an @cf/ prefix is not enough on its
    // own — @cf/deepseek-ai/deepseek-v4-pro-0813 is Cloudflare-hosted but
    // failed with "5035: ... is not available on the Workers Free plan".
    // Small open-weight models are the ones the free plan covers.
    "TEXT_MODEL": "@cf/mistral/mistral-7b-instruct-v0.2-lora"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The API routes need the Worker; worker-index/* is fetched *through*
    // the binding from inside the Worker, so it does not need listing here.
    "run_worker_first": ["/api/*"]
  }
}
