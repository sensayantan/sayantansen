# Copy this file to .env and fill in real values. Never commit .env.

# Set which provider generate_news.py uses: "anthropic" or "openai".
AI_PROVIDER=anthropic

# --- Anthropic (used when AI_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
# claude-sonnet-5 (default if unset) is far cheaper than claude-opus-5 for
# this research/summarize workload. Only override to claude-opus-5 if you
# want to compare output quality.
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI (used when AI_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# If your account's models use the newer non-preview web search tool
# instead, set this to: web_search
OPENAI_WEB_SEARCH_TOOL=web_search_preview
